fn say_hello() {
    say(42);
}
fn add(a, b) {
    say(a + b);
}
fn greet(name: word) {
    say(name);
}
fn multiply(a, b) {
    gives(a * b);
}
fn print_double(x) {
    say(x * 2);
}
fn square(x) {
    gives(x * x);
}
fn double_it(x) {
    gives(x * 2);
}
fn add_doubles(a, b) {
    gives(double_it(a) + double_it(b));
}
fn printer(arr: word[],n:number) -> word {
    gives(arr[0]);
}

fn the_precious() {
    // ============================================================
    // Precious Language — Comprehensive Showcase
    // ============================================================
    // This file exercises every feature currently implemented.
    // Run with: ./build/precious src/test.precious && ./test

    // --- Variables & Type Annotations ---
    my count: number = 42;
    my greeting: word = "hello";
    my inferred_num = 99;
    my inferred_str = "world";

    // --- Arithmetic ---
    my a = 10;
    my b = 3;
    say(a + b);         // 13
    say(a - b);         // 7
    say(a * b);         // 30
    say(a / b);         // 3
    say(a + b * 2);     // 16  (precedence: * before +)
    say((a + b) * 2);   // 26  (parens override)

    // --- Comparison Operators ---
    say(a == b);        // 0
    say(a != b);        // 1
    say(a > b);         // 1
    say(a < b);         // 0
    say(a >= 10);       // 1
    say(b <= 5);        // 1

    // --- Boolean Operators ---
    my x = 5;
    if (x > 0 and x < 10) {
        say(1);         // prints 1
    }
    if (x == 1 or x == 5) {
        say(2);         // prints 2
    }
    if (!0) {
        say(3);         // prints 3
    }

    // --- String Variables with say ---
    my name: word = "gollum";
    say(name);          // gollum
    my msg = "the precious";
    say(msg);           // the precious

    // --- If / Elif / Else ---
    my score = 85;
    if (score >= 90) {
        say(100);
    } elif (score >= 80) {
        say(90);        // prints 90
    } elif (score >= 70) {
        say(80);
    } else {
        say(0);
    }

    // --- While Loop ---
    my i = 0;
    while (i < 5) {
        i = i + 1;
    }
    say(i);             // 5

    // --- Scopes ---
    my outer = 10;
    {
        my inner = 5;
        say(outer + inner); // 15
    }

    // --- Functions: no params, no return ---
    say_hello();        // 42

    // --- Functions: with params ---
    add(10, 20);        // 30

    // --- Functions: param type annotations ---
    greet("precious");  // precious

    // --- Functions: return values ---
    my product = multiply(6, 7);
    say(product);       // 42

    // --- Functions: mixed (void and returning) ---
    print_double(5);    // 10
    my sq = square(8);
    say(sq);            // 64

    // --- Function call in expression ---
    my result = square(3) + square(4);
    say(result);        // 25  (9 + 16)

    // --- Functions calling functions ---


    my lol: word[3] = ["yara","yara","phonk"];
    my saying = printer(lol,3);
    say(saying);

    my dd = add_doubles(3, 4);
    say(dd);            // 14  (6 + 8)

    // --- String variables used with say ---
    my title = "master";
    say(title);         // master

    // --- Arrays ---
    my numbers: number[3] = [10, 20, 30];
    say(numbers[0]);    // 10
    say(numbers[1]);    // 20
    say(numbers[2]);    // 30

    // Array assignment
    numbers[1] = 99;
    say(numbers[1]);    // 99

    // String arrays
    my words: word[2] = ["hello", "world"];
    say(words[0]);      // hello
    say(words[1]);      // world

    // Array with variable index
    my idx: number = 2;
    say(numbers[idx]);    // 30

    // --- Final exit code ---
    gives(0);

    my o = 0;
    while (o < 100) {
        if (o == 5) {
            break;
        }
        o = o + 1;
    }
    say(o);
    // Test continue: skip even numbers, only print odds 1,3,5
    my j = 0;
    while (j < 6) {
        j = j + 1;
        if (j % 2 == 0) {
            continue;
        }
        say(j);
    }
    // Test break + continue combined: skip evens, break at 9
    my n = 0;
    while (n < 20) {
        n = n + 1;
        if (n % 2 == 0) {
            continue;
        }
        if (n == 9) {
            break;
        }
        say(n);
    }
    gives(0);
}
